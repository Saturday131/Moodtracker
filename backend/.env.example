# Copy this file to .env and fill in your values

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Name of the MongoDB database
DB_NAME=mood_tracker

# Long random string used to sign JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the same value across environments, and never commit the real value.
JWT_SECRET=

# OpenAI API key (AI features: chat, summaries, note analysis)
# Get one at platform.openai.com — new accounts get free credit
EMERGENT_LLM_KEY=

# Directory where ChromaDB stores its vector search index.
# Defaults to a chroma_data/ folder next to server.py.
# In production (Docker) set this to a path backed by a persistent volume.
CHROMA_PATH=./chroma_data

# Resend API key for sending password reset emails (free tier at resend.com)
RESEND_API_KEY=

# Comma-separated list of origins allowed to call the API.
# For the web build, add your frontend URL. Mobile apps don't use CORS.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
